{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "waxsc/release-gallery",
	"title": "Release gallery",
	"category": "widgets",
	"icon": "format-gallery",
	"description": "Other photos of a release: back cover, center label, insert…",
	"textdomain": "wax-store-catalog",
	"attributes": {},
	"supports": {
		"html": false,
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true
		}
	},
	"editorScript": "waxsc-blocks-editor",
	"style": "waxsc-blocks",
	"render": "file:./render.php",
	"usesContext": [
		"postId",
		"postType"
	]
}