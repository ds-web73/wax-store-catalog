{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "waxsc/release-price",
	"title": "Release price",
	"category": "widgets",
	"icon": "tag",
	"description": "Price of a release, with the reserve or buy button.",
	"textdomain": "wax-store-catalog",
	"attributes": {
		"showAction": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true
		}
	},
	"editorScript": "waxsc-blocks-editor",
	"style": "waxsc-blocks",
	"render": "file:./render.php",
	"usesContext": [
		"postId",
		"postType"
	]
}