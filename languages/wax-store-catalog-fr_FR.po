msgstr "Chaque exemplaire avec ses gradings, notes, prix et statut."

#: blocks/release-details/block.json
msgctxt "block title"
msgid "Release details"
msgstr "Détails de la référence"

#: blocks/release-details/block.json
msgctxt "block description"
msgid "Format, label, catalog number, year, country, barcode and features."
msgstr ""
"Format, label, numéro de catalogue, année, pays, code-barre et "
"particularités."

#: blocks/release-gallery/block.json
msgctxt "block title"
msgid "Release gallery"
msgstr "Galerie de la référence"

#: blocks/release-gallery/block.json
msgctxt "block description"
msgid "Other photos of a release: back cover, center label, insert…"
msgstr "Autres photos d’une référence : verso, rond central, insert…"

#: blocks/release-price/block.json
msgctxt "block title"
msgid "Release price"
msgstr "Prix de la référence"

#: blocks/release-price/block.json
msgctxt "block description"
msgid "Price of a release, with the reserve or buy button."
msgstr "Prix d’une référence, avec le bouton de réservation ou d’achat."

#: blocks/release-summary/block.json
msgctxt "block title"
msgid "Release summary"
msgstr "Résumé de la référence"

#: blocks/release-summary/block.json
msgctxt "block description"
msgid "Format, year and grades, for catalog grids."
msgstr "Format, année et gradings, pour les grilles du catalogue."

#: blocks/release-tracklist/block.json
msgctxt "block title"
msgid "Tracklist"
msgstr "Liste des titres"

#: blocks/release-tracklist/block.json
msgctxt "block description"
msgid "Track positions, titles and durations."
msgstr "Positions, titres et durées des morceaux."

#: blocks/reservation-form/block.json
msgctxt "block title"
msgid "Reservation form"
msgstr "Formulaire de réservation"

#: blocks/reservation-form/block.json
msgctxt "block description"
msgid ""
"Lets visitors reserve a copy, or ask for a record. Place it on your "
"reservation page."
msgstr ""
"Permet aux visiteurs de réserver un exemplaire ou de demander un disque. À "
"placer sur votre page de réservation."

#: blocks/sell-form/block.json
msgctxt "block title"
msgid "Sell us your records"
msgstr "Vendez-nous vos disques"

#: blocks/sell-form/block.json
msgctxt "block description"
msgid ""
"Lets visitors offer you their records or a collection, with photos and a "
"list."
msgstr ""
"Permet aux visiteurs de vous proposer leurs disques ou une collection, avec "
"photos et liste."

#: blocks/shop-status/block.json
msgctxt "block title"
msgid "Shop opening status"
msgstr "Ouvert aujourd’hui"

#: blocks/shop-status/block.json
msgctxt "block description"
msgid ""
"Open today until 7 pm, opens tomorrow at 11 am… from the opening hours of "
"the shop settings."
msgstr ""
"Ouvert aujourd’hui jusqu’à 19 h, ouvre demain à 11 h… d’après les horaires "
"des réglages de la boutique."
