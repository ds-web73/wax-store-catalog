msgid_plural "%d releases without cover have not been searched yet."
msgstr[0] "%d référence sans pochette n’a pas encore été cherchée."
msgstr[1] "%d références sans pochette n’ont pas encore été cherchées."

#: src/Admin/CoversPage.php:102
msgid ""
"MusicBrainz allows one request per second: count about one hour for 1,500 "
